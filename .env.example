# Скопируйте в .env. Не отправляйте API-ключ в чат или в Git.
OPENAI_BASE_URL=https://api.vsellm.ru/v1
OPENAI_API_KEY=
# Укажите точный ID доступной EMBEDDING-модели из кабинета или chapter2 models.
EMBEDDING_MODEL=
# Только для дополнительного примера multivector:
CHAT_MODEL=
CHUNK_SIZE=500
CHUNK_OVERLAP=100
